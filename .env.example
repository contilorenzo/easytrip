# Copia questo file in .env.local e inserisci i tuoi valori (.env.local non finisce su git)
EXPO_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Token pubblico Mapbox (indicazioni stradali)
EXPO_PUBLIC_MAPBOX_TOKEN=
# Chiave Google Maps (letta da app.config.js)
GOOGLE_MAPS_API_KEY=
# Solo sviluppo: simula il server dei voli (scenari scelti dal nome della città: errore, offline, limite, vuota, lenta)
# EXPO_PUBLIC_FLIGHTS_MOCK=1
# Token, marker e ID progetto Travelpayouts NON vanno qui: sono segreti della Edge Function (TRAVELPAYOUTS_TOKEN, TRAVELPAYOUTS_MARKER, TRAVELPAYOUTS_TRS)
