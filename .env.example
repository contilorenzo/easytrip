# Copia questo file in .env.local e inserisci i tuoi valori (.env.local non finisce su git)
EXPO_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Token pubblico Mapbox (indicazioni stradali)
EXPO_PUBLIC_MAPBOX_TOKEN=
# Chiave Google Maps (letta da app.config.js)
GOOGLE_MAPS_API_KEY=
