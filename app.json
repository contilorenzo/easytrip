{
  "expo": {
    "name": "easytrip",
    "icon": "./assets/icon.png",
    "slug": "easytrip",
    "orientation": "portrait",
    "scheme": "acme",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-splash-screen",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Visualizza la tua posizione sulla mappa per orientarti durante il viaggio."
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "Importa le tue prenotazioni dal calendario per aggiungere gli alloggi ai viaggi.",
          "remindersPermission": false
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5dc4dd27-efbe-48b8-b6a9-95c01bf0cd03"
      }
    },
    "ios": {
      "bundleIdentifier": "com.contilorenzo.easytrip",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Visualizza la tua posizione sulla mappa per orientarti durante il viaggio.",
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "citymapper",
          "waze"
        ]
      }
    },
    "android": {
      "package": "com.contilorenzo.easytrip",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E53828"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "newArchEnabled": false
  }
}
